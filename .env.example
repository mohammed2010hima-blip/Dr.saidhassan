# Database URL (SQLite or PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Cookies
JWT_SECRET="your-super-secret-jwt-key"

# AES-256-GCM Encryption Secret (32-char string)
ENCRYPTION_SECRET="0123456789abcdef0123456789abcdef"

# Fallback Google Gemini API Key (Teacher can also enter their key in dashboard settings)
GOOGLE_GEMINI_API_KEY=""

# Default AI Model (e.g. gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro)
DEFAULT_GEMINI_MODEL="gemini-2.0-flash"
